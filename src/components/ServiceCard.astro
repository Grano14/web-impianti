---
import Icon from './Icon.astro';
import type { Service } from '../data/services';
import { url } from '../utils/url';

interface Props {
  service: Service;
}
const { service } = Astro.props;
---

<article class="group relative flex flex-col rounded-2xl border border-ink-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-primary-300 hover:shadow-lg sm:p-8">
  <div class="flex size-14 items-center justify-center rounded-xl bg-primary-50 text-primary-600 ring-1 ring-primary-100">
    <Icon name={service.icon} class="size-8" />
  </div>
  <h3 class="mt-5 text-xl font-bold text-ink-900">{service.title}</h3>
  <p class="mt-3 flex-1 text-ink-600">{service.excerpt}</p>
  <a
    href={url(`/servizi/#${service.id}`)}
    class="mt-6 inline-flex items-center gap-1.5 font-semibold text-primary-700 after:absolute after:inset-0 after:rounded-2xl group-hover:text-primary-800"
  >
    Scopri di più<span class="sr-only"> su {service.title.toLowerCase()}</span>
    <Icon name="arrowRight" class="size-4 transition-transform group-hover:translate-x-1" />
  </a>
</article>
