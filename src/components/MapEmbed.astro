---
/**
 * Mappa OpenStreetMap caricata SOLO dopo il clic dell'utente.
 * Finché non si clicca, il browser non contatta alcun server esterno:
 * nessun dato (indirizzo IP, cookie) viene trasmesso a terzi.
 * Le coordinate si impostano in src/config/site.ts (campo `geo`).
 */
import Icon from './Icon.astro';
import { site, fullAddress } from '../config/site';
import { url } from '../utils/url';

const { lat, lng } = site.geo;
const d = 0.006;
const embedSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${lng - d * 1.6},${lat - d},${lng + d * 1.6},${lat + d}&layer=mapnik&marker=${lat},${lng}`;
const osmLink = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=17/${lat}/${lng}`;
const directionsLink = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(fullAddress)}`;
---

<div class="overflow-hidden rounded-2xl border border-ink-200 bg-white shadow-sm">
  <div data-map class="relative aspect-[4/3] w-full bg-ink-100 sm:aspect-video lg:aspect-[21/9]">
    <div data-map-placeholder class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-6 text-center">
      <Icon name="map" class="size-12 text-ink-400" />
      <p class="max-w-sm text-sm text-ink-600">
        Per proteggere la tua privacy la mappa non viene caricata automaticamente. Cliccando sul pulsante ti
        colleghi a OpenStreetMap, un servizio esterno (<a href={url('/privacy/')} class="font-medium text-primary-700 underline">maggiori informazioni</a>).
      </p>
      <button
        type="button"
        data-map-load
        class="hidden items-center gap-2 rounded-lg bg-ink-900 px-5 py-3 font-semibold text-white hover:bg-ink-800 [.js_&]:inline-flex"
      >
        <Icon name="pin" class="size-5" />
        Mostra la mappa
      </button>
      <noscript>
        <a href={osmLink} class="font-semibold text-primary-700 underline" target="_blank" rel="noopener noreferrer">
          Apri la mappa su OpenStreetMap
        </a>
      </noscript>
    </div>
    <template data-map-template>
      <iframe
        src={embedSrc}
        title={`Mappa: ${fullAddress}`}
        class="absolute inset-0 size-full border-0"
        loading="lazy"
        referrerpolicy="no-referrer"
      ></iframe>
    </template>
  </div>
  <div class="flex flex-col gap-3 border-t border-ink-200 p-4 text-sm sm:flex-row sm:items-center sm:justify-between">
    <p class="flex items-start gap-2 text-ink-700">
      <Icon name="pin" class="mt-0.5 size-5 shrink-0 text-primary-600" />
      {fullAddress}
    </p>
    <a
      href={directionsLink}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex shrink-0 items-center gap-1.5 font-semibold text-primary-700 hover:text-primary-800 hover:underline"
    >
      Indicazioni stradali
      <Icon name="external" class="size-4" />
      <span class="sr-only">(apre Google Maps in una nuova scheda)</span>
    </a>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((map) => {
    const button = map.querySelector<HTMLButtonElement>('[data-map-load]');
    const template = map.querySelector<HTMLTemplateElement>('[data-map-template]');
    const placeholder = map.querySelector('[data-map-placeholder]');
    button?.addEventListener('click', () => {
      if (!template) return;
      map.appendChild(template.content.cloneNode(true));
      placeholder?.remove();
      map.querySelector('iframe')?.focus();
    });
  });
</script>
