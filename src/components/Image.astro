---
/**
 * Mostra una foto da `public/images/` oppure, se non è ancora stata caricata,
 * un riquadro grigio con l'etichetta di cosa andrà inserito.
 * Le immagini si configurano in `src/config/images.ts`.
 */
import type { SiteImage } from '../config/images';
import { url } from '../utils/url';

interface Props {
  image: SiteImage;
  /** Proporzioni del riquadro, es. "aspect-[4/3]" o "aspect-video" */
  aspect?: string;
  class?: string;
  /** true per le immagini visibili subito (es. hero): non vengono caricate in differita */
  eager?: boolean;
}

const { image, aspect = 'aspect-[4/3]', class: className = '', eager = false } = Astro.props;
---

{
  image.src ? (
    <img
      src={url(`/images/${image.src}`)}
      alt={image.alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class:list={['w-full object-cover', aspect, className]}
    />
  ) : (
    <div
      role="img"
      aria-label={image.alt}
      class:list={[
        'flex w-full items-center justify-center border-2 border-dashed border-ink-300 bg-ink-100 p-6 text-center',
        aspect,
        className,
      ]}
    >
      <div class="flex max-w-xs flex-col items-center gap-3 text-ink-500" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-10">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"
          />
        </svg>
        <span class="text-sm font-medium">{image.label}</span>
      </div>
    </div>
  )
}
