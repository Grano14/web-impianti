---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { url, formatDate } from '../utils/url';

interface Props {
  item: CollectionEntry<'comunicazioni'>;
  /** Livello del titolo, in base a dove è inserita la card */
  headingLevel?: 'h2' | 'h3';
}
const { item, headingLevel: Heading = 'h3' } = Astro.props;
const { title, description, date, category } = item.data;
---

<article class="group relative flex flex-col rounded-2xl border border-ink-200 bg-white p-6 shadow-sm transition hover:border-primary-300 hover:shadow-md">
  <div class="flex flex-wrap items-center gap-3 text-sm">
    <span
      class:list={[
        'rounded-full px-2.5 py-0.5 text-xs font-semibold',
        category === 'Avviso' ? 'bg-ink-900 text-white' : 'bg-primary-100 text-primary-800',
      ]}
    >
      {category}
    </span>
    <time datetime={date.toISOString().slice(0, 10)} class="flex items-center gap-1.5 text-ink-500">
      <Icon name="calendar" class="size-4" />
      {formatDate(date)}
    </time>
  </div>
  <Heading class="mt-4 text-lg font-bold text-ink-900 group-hover:text-primary-700">
    <a href={url(`/comunicazioni/${item.id}/`)} class="after:absolute after:inset-0 after:rounded-2xl">
      {title}
    </a>
  </Heading>
  <p class="mt-2 flex-1 text-ink-600">{description}</p>
  <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary-700" aria-hidden="true">
    Leggi tutto <Icon name="arrowRight" class="size-4 transition-transform group-hover:translate-x-1" />
  </span>
</article>
