---
/**
 * Logo in immagine (contiene già il nome dell'attività).
 * Il file va sostituito in public/images/logo.png.
 */
import { site } from '../config/site';
import { url } from '../utils/url';

interface Props {
  /** "dark" per sfondi chiari, "light" per sfondi scuri (per ora il logo è lo stesso in entrambi i casi) */
  tone?: 'dark' | 'light';
}
const { tone: _tone = 'dark' } = Astro.props;
---

<img src={url('/images/logo.png')} alt={site.name} class="h-10 w-auto shrink-0" />
