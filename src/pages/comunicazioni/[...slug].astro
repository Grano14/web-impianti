---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import Button from '../../components/Button.astro';
import { getComunicazioni } from '../../utils/comunicazioni';
import { url, formatDate } from '../../utils/url';

export async function getStaticPaths() {
  const items = await getComunicazioni();
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const { title, description, date, category } = item.data;
---

<BaseLayout title={title} description={description} type="article">
  <PageHeader title={title} parent={{ label: 'Comunicazioni', href: '/comunicazioni/' }} />

  <article class="py-12 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <span
          class:list={[
            'rounded-full px-2.5 py-0.5 text-xs font-semibold',
            category === 'Avviso' ? 'bg-ink-900 text-white' : 'bg-primary-100 text-primary-800',
          ]}
        >
          {category}
        </span>
        <time datetime={date.toISOString().slice(0, 10)} class="flex items-center gap-1.5 text-ink-500">
          <Icon name="calendar" class="size-4" />
          Pubblicato il {formatDate(date)}
        </time>
      </div>

      <p class="mt-6 text-xl leading-relaxed text-ink-700">{description}</p>

      <div class="prose-site mt-8 border-t border-ink-200 pt-8 text-lg">
        <Content />
      </div>

      <div class="mt-12 flex flex-col gap-4 border-t border-ink-200 pt-8 sm:flex-row sm:items-center sm:justify-between">
        <a
          href={url('/comunicazioni/')}
          class="inline-flex items-center gap-2 font-semibold text-primary-700 hover:text-primary-800 hover:underline"
        >
          <Icon name="arrowLeft" class="size-4" />
          Tutte le comunicazioni
        </a>
        <Button href={url('/contatti/')}>Contattaci</Button>
      </div>
    </div>
  </article>
</BaseLayout>
