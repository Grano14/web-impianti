---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import NewsCard from '../../components/NewsCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { site } from '../../config/site';
import { getComunicazioni } from '../../utils/comunicazioni';

const items = await getComunicazioni();
---

<BaseLayout
  title="Comunicazioni: avvisi e novità"
  description={`Avvisi, novità e offerte di ${site.name}: chiusure, promozioni, aggiornamenti su incentivi e servizi per impianti elettrici e fotovoltaici.`}
>
  <PageHeader
    title="Comunicazioni"
    subtitle="Avvisi, novità e iniziative: qui trovi tutte le informazioni utili aggiornate."
  />

  <section class="py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      {
        items.length > 0 ? (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {items.map((item) => (
              <NewsCard item={item} headingLevel="h2" />
            ))}
          </div>
        ) : (
          <p class="text-center text-lg text-ink-600">Al momento non ci sono comunicazioni.</p>
        )
      }
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
