---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { mainNav } from '../config/navigation';
import { url } from '../utils/url';
---

<BaseLayout title="Pagina non trovata" description="La pagina che cerchi non esiste o è stata spostata." noindex>
  <section class="py-20 sm:py-28">
    <div class="mx-auto max-w-xl px-4 text-center sm:px-6">
      <p class="text-6xl font-extrabold text-primary-600">404</p>
      <h1 class="mt-4 text-3xl font-bold tracking-tight text-ink-900 sm:text-4xl">Pagina non trovata</h1>
      <p class="mt-4 text-lg text-ink-600">La pagina che cerchi non esiste o è stata spostata. Prova da uno di questi link:</p>
      <ul class="mt-8 flex flex-wrap justify-center gap-3">
        {
          mainNav.map((item) => (
            <li>
              <Button href={url(item.href)} variant={item.href === '/' ? 'primary' : 'secondary'}>
                {item.label}
              </Button>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
